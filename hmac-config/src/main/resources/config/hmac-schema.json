{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "type" : "object",
  "required" : [ "enabled", "profiles" ],
  "properties" : {
    "enabled" : {
      "type" : "boolean",
      "description" : "Enable raw-body HMAC webhook authentication.",
      "default" : false
    },
    "profiles" : {
      "type" : "object",
      "description" : "Named HMAC verification profiles. Secret values are referenced only by environment-variable name.",
      "additionalProperties" : {
        "type" : "object",
        "properties" : {
          "signedInput" : {
            "type" : "string",
            "default" : "rawBody"
          },
          "algorithm" : {
            "type" : "string",
            "default" : "hmacSha256"
          },
          "allowedMethods" : {
            "type" : "array",
            "minItems" : 1,
            "default" : [ "POST" ],
            "items" : {
              "type" : "string"
            }
          },
          "signatureHeader" : {
            "type" : "string"
          },
          "signaturePrefix" : {
            "type" : "string"
          },
          "signatureEncoding" : {
            "type" : "string",
            "default" : "hex"
          },
          "maxBodyBytes" : {
            "type" : "integer",
            "default" : 16777216,
            "minimum" : 1,
            "format" : "int32"
          },
          "secrets" : {
            "type" : "object",
            "properties" : {
              "selectorHeader" : {
                "type" : "string"
              },
              "bySelector" : {
                "type" : "object",
                "additionalProperties" : {
                  "type" : "array",
                  "minItems" : 1,
                  "maxItems" : 2,
                  "items" : {
                    "type" : "string"
                  }
                }
              },
              "defaultEnvNames" : {
                "type" : "array",
                "maxItems" : 2,
                "default" : [ ],
                "items" : {
                  "type" : "string"
                }
              }
            }
          },
          "replay" : {
            "type" : "object",
            "properties" : {
              "enabled" : {
                "type" : "boolean",
                "default" : false
              },
              "idHeader" : {
                "type" : "string"
              },
              "retentionSeconds" : {
                "type" : "integer",
                "default" : 604800,
                "minimum" : 1,
                "format" : "int32"
              }
            }
          }
        }
      }
    }
  }
}
